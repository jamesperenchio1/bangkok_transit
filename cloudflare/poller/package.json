{
  "name": "bangkok-transit-poller",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir .wrangler/dist",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.1",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.157.0"
  }
}
