{
  "openapi": "3.1.0",
  "info": {
    "title": "Bangkok Transit APIs",
    "version": "1.0.0",
    "summary": "A free live-arrivals document, and a paid (x402) API for AI agents.",
    "description": "Two public APIs. (1) A free, read-only document of live BTS train arrivals on live.bangkok-transit.com: one shared JSON file on Cloudflare's CDN refreshed every few seconds from a public BTS arrivals feed; no account or key; covers BTS Sukhumvit and Silom only; poll no more often than every 15 seconds. (2) A pay-per-call API on bangkok-transit.com/api/v1 for AI agents, paid with x402 (HTTP 402, USDC): live arrivals for one station, route planning, and station and line facts. The website, map, markdown pages and llms.txt are free. GET /api/v1 is free and states the current price list, the network, the pay-to address and whether payments are in test mode. Calls that fail (unknown station, no current reading) are not charged. Times are estimates, not a timetable.",
    "x-provided-as-is": "Estimates from a third-party public arrivals feed; no warranty or timetable guarantee."
  },
  "servers": [
    {
      "url": "https://live.bangkok-transit.com"
    }
  ],
  "externalDocs": {
    "description": "Site overview for agents (llms.txt)",
    "url": "https://bangkok-transit.com/llms.txt"
  },
  "paths": {
    "/arrivals.json": {
      "get": {
        "operationId": "getLiveArrivals",
        "summary": "Live arrivals for every BTS Sukhumvit and Silom station",
        "description": "Returns the whole document. Each station's reading carries its own `timestamp` (UTC, with no trailing Z). Treat a reading older than about 90 seconds as last-known and drop one older than 30 minutes. The `Date` and `Age` response headers (exposed to browsers) give the edge copy's age.",
        "responses": {
          "200": {
            "description": "The current document.",
            "headers": {
              "Cache-Control": {
                "description": "Short edge cache (a few seconds) with stale-if-error.",
                "schema": {
                  "type": "string"
                }
              },
              "Date": {
                "description": "When the edge answered.",
                "schema": {
                  "type": "string"
                }
              },
              "Age": {
                "description": "Seconds the edge copy has been cached.",
                "schema": {
                  "type": "integer"
                }
              },
              "Access-Control-Allow-Origin": {
                "description": "`*`: readable from any web page.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArrivalsDocument"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1": {
      "servers": [
        {
          "url": "https://bangkok-transit.com"
        }
      ],
      "get": {
        "operationId": "getApiIndex",
        "summary": "Price list and payment details (free)",
        "description": "Lists every paid endpoint with its price, and states the x402 network, the pay-to address and whether payments are in test mode (test USDC with no monetary value).",
        "responses": {
          "200": {
            "description": "The index.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/arrivals": {
      "servers": [
        {
          "url": "https://bangkok-transit.com"
        }
      ],
      "get": {
        "summary": "Live arrivals at one BTS station",
        "description": "Live train arrivals for one BTS Sukhumvit or Silom station. Each reading carries its timestamp and age and says whether it is last-known; readings older than 30 minutes are not served. Costs $0.002 per successful call, paid with x402 v2: an unpaid call gets HTTP 402 with a PAYMENT-REQUIRED header; retry with a PAYMENT-SIGNATURE header.",
        "x-price-usd": 0.002,
        "parameters": [
          {
            "name": "station",
            "in": "query",
            "required": true,
            "description": "Station code, for example N8 or CEN.",
            "schema": {
              "type": "string",
              "example": "N8"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The reading.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "description": "Unknown station or line, or no current reading. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Payments or live data temporarily unavailable. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/route": {
      "servers": [
        {
          "url": "https://bangkok-transit.com"
        }
      ],
      "get": {
        "summary": "Route between two stations",
        "description": "Best route between two stations on any Bangkok rail line: lines, where to change, direction to board, walking transfers, stops and estimated minutes. Costs $0.005 per successful call, paid with x402 v2: an unpaid call gets HTTP 402 with a PAYMENT-REQUIRED header; retry with a PAYMENT-SIGNATURE header.",
        "x-price-usd": 0.005,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Start station code or slug.",
            "schema": {
              "type": "string",
              "example": "N8"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Destination station code or slug.",
            "schema": {
              "type": "string",
              "example": "A08"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The route.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "description": "Unknown station or line, or no current reading. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Payments or live data temporarily unavailable. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stations/{slug}": {
      "servers": [
        {
          "url": "https://bangkok-transit.com"
        }
      ],
      "get": {
        "summary": "Facts about one station",
        "description": "Names (English and Thai), official code, lines, neighbouring stations, walking interchanges and coordinates. Costs $0.001 per successful call, paid with x402 v2: an unpaid call gets HTTP 402 with a PAYMENT-REQUIRED header; retry with a PAYMENT-SIGNATURE header.",
        "x-price-usd": 0.001,
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Page slug (siam-cen) or station code (CEN).",
            "schema": {
              "type": "string",
              "example": "siam-cen"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The station.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "description": "Unknown station or line, or no current reading. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Payments or live data temporarily unavailable. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lines/{slug}": {
      "servers": [
        {
          "url": "https://bangkok-transit.com"
        }
      ],
      "get": {
        "summary": "Facts about one line",
        "description": "Name (English and Thai), terminal stations and every station in order, branch by branch. Costs $0.001 per successful call, paid with x402 v2: an unpaid call gets HTTP 402 with a PAYMENT-REQUIRED header; retry with a PAYMENT-SIGNATURE header.",
        "x-price-usd": 0.001,
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Line slug, for example bts-sukhumvit-line.",
            "schema": {
              "type": "string",
              "example": "bts-sukhumvit-line"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The line.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "description": "Unknown station or line, or no current reading. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Payments or live data temporarily unavailable. Not charged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArrivalsDocument": {
        "type": "object",
        "required": [
          "arrivals",
          "total",
          "complete"
        ],
        "properties": {
          "arrivals": {
            "type": "object",
            "description": "Latest reading per station, keyed by the station's code (for example `N8`, `CEN`).",
            "additionalProperties": {
              "$ref": "#/components/schemas/Arrivals"
            }
          },
          "total": {
            "type": "integer",
            "description": "How many stations have live arrivals at all."
          },
          "complete": {
            "type": "boolean",
            "description": "True once the latest full poll has landed and is current, or the source is known to be down."
          },
          "status": {
            "$ref": "#/components/schemas/UpstreamStatus"
          },
          "poll": {
            "$ref": "#/components/schemas/PollReport"
          }
        }
      },
      "Arrivals": {
        "type": "object",
        "required": [
          "station",
          "platforms",
          "near_end_of_service",
          "service_active",
          "next_service",
          "server_time",
          "timestamp"
        ],
        "properties": {
          "station": {
            "type": "object",
            "required": [
              "code",
              "name_en",
              "name_th",
              "line_color"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "name_en": {
                "type": "string"
              },
              "name_th": {
                "type": "string"
              },
              "line_color": {
                "type": "string",
                "description": "Hex colour of the line."
              }
            }
          },
          "platforms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Platform"
            }
          },
          "near_end_of_service": {
            "type": "boolean"
          },
          "service_active": {
            "type": "boolean"
          },
          "next_service": {
            "type": "string",
            "description": "When service next starts, if it is not running."
          },
          "server_time": {
            "type": "string",
            "description": "The source's own clock when it answered, as Bangkok local time (UTC+7) written dd/mm/yyyy HH:mm, for example `09/11/2026 15:47`. Not ISO 8601: use `timestamp` for the time of the reading."
          },
          "timestamp": {
            "type": "string",
            "description": "When this reading was taken: UTC, ISO 8601 with fractional seconds and no trailing Z, for example `2026-11-09T08:47:08.157629`. Append Z before parsing."
          }
        }
      },
      "Platform": {
        "type": "object",
        "required": [
          "platform",
          "line_color",
          "line_id",
          "direction",
          "direction_key",
          "trains"
        ],
        "properties": {
          "platform": {
            "type": "string"
          },
          "line_color": {
            "type": "string"
          },
          "line_id": {
            "type": "integer"
          },
          "direction": {
            "type": "string",
            "description": "Thai and English destination joined in one string."
          },
          "direction_key": {
            "type": "string",
            "description": "Code of the terminus station in this direction."
          },
          "trains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Train"
            }
          },
          "carried_from": {
            "type": "string",
            "description": "Set when these trains come from an older reading because the newest listed none for this direction. It is that older reading's `timestamp`: UTC, ISO 8601 with no trailing Z. Append Z before parsing."
          }
        }
      },
      "Train": {
        "type": "object",
        "required": [
          "train_no",
          "destination",
          "destination_key",
          "status"
        ],
        "properties": {
          "train_no": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "destination_key": {
            "type": "string"
          },
          "eta_minutes": {
            "type": "number",
            "description": "Minutes until arrival, as reported by the source."
          },
          "eta_precise": {
            "type": "number",
            "description": "The same, with a fractional part."
          },
          "status": {
            "type": "string"
          }
        }
      },
      "UpstreamStatus": {
        "type": "object",
        "description": "Health of the upstream arrivals feed, as the poller sees it.",
        "required": [
          "state",
          "since",
          "lastSuccessAt",
          "incidents"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "down"
            ]
          },
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "incidents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "format": "date-time"
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "PollReport": {
        "type": "object",
        "description": "What the latest poll did. Diagnostics only.",
        "required": [
          "at",
          "ms",
          "polled",
          "ok",
          "failed"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "ms": {
            "type": "number"
          },
          "polled": {
            "type": "integer"
          },
          "ok": {
            "type": "integer"
          },
          "failed": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "PaymentRequired": {
        "description": "Payment required (x402 v2). The PAYMENT-REQUIRED response header holds base64-encoded JSON with the accepted payment (scheme exact, network, asset, amount, payTo). Pay and retry with a PAYMENT-SIGNATURE header. See https://x402.org.",
        "headers": {
          "PAYMENT-REQUIRED": {
            "description": "Base64-encoded JSON payment requirements.",
            "schema": {
              "type": "string"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
